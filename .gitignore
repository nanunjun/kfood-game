# ===== Godot 4.x (ADR-004) =====
# 참고: https://github.com/github/gitignore/blob/main/Godot.gitignore
.godot/
.import/
*.translation
# Godot Android custom build 전체 캐시 (1GB+ gradle/build intermediates)
# .build_version은 보존, build/ 하위는 모두 ignore (재생성)
godot-project/android/build/
# Firebase secret
godot-project/google-services.json
# Plugin 생성 native 모듈 (재설치 시 plugin이 재배치, 클론 후 재설치 절차로 복원)
# 보존 결정: addons/ 만 SSOT, android/firebase_*, ios/ 는 ignore
godot-project/android/firebase_core/
godot-project/android/firebase_analytics/
godot-project/android/firebase_crashlytics/
godot-project/android/firebase_messaging/
godot-project/ios/

# ===== Unity (legacy, ADR-004 이전 — 안전상 잔존) =====
# 참고: https://github.com/github/gitignore/blob/main/Unity.gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data 충돌 방지: meta 파일은 커밋해야 함 (기본 Unity 정책)
# 단, Asset 본체가 ignore되면 meta도 같이 ignore

# Visual Scripting 자동생성
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Autogenerated Jetbrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity가 IDE 메타데이터 자동 재생성
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 빌드 산출물
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===== 프로젝트 빌드 산출물 =====
/build/
!/build/README.md
!/build/.gitkeep

# ===== Windows OS =====
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk

# ===== macOS (혼합 팀 대비) =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===== IDE: Visual Studio / Rider / VS Code =====
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ===== JetBrains Rider =====
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ===== Node / 도구 캐시 (스크립트용) =====
node_modules/
.npm/

# ===== 환경/시크릿 =====
.env
.env.local
*.keystore
*.jks
keystore.properties

# ===== Python (tools/) =====
__pycache__/
*.pyc
*.pyo

# ===== 큰 원본 에셋: LFS 권장, 일단 트래킹 안함 =====
# 필요 시 LFS 설정 후 아래 라인 제거하고 .gitattributes로 관리
# /assets-raw/**/*.psd
# /assets-raw/**/*.wav
assets-raw/transparent_m1_v2/
assets-raw/transparent_m1_v3_isnet/
