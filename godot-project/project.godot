; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="K-Food Master"
config/description="한식 cooking matching 캐주얼 모바일 게임 (떡볶이, 김밥, 김치, 비빔밥 등 12종)."
config/version="0.1.0"
run/main_scene="res://scenes/menu_select.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icons/icon.svg"

[autoload]

RemoteConfigManager="*res://scripts/autoload/remote_config_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AdsManager="*res://scripts/autoload/ads_manager.gd"
IapManager="*res://scripts/autoload/iap_manager.gd"
AnalyticsManager="*res://scripts/autoload/analytics_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
BeatClock="*res://scripts/autoload/beat_clock.gd"
Tuning="*res://scripts/autoload/tuning.gd"
HapticManager="*res://scripts/autoload/haptic_manager.gd"
FeedbackBus="*res://scripts/autoload/feedback_bus.gd"
MoodSystem="*res://scripts/autoload/mood_system.gd"
CompatCalc="*res://scripts/autoload/compatibility.gd"
RewardCalc="*res://scripts/autoload/reward_calc.gd"
RecipeXP="*res://scripts/autoload/recipe_xp.gd"
ReactionDB="*res://scripts/autoload/reaction_db.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/android_IAPP/plugin.cfg", "res://addons/godotx_firebase/plugin.cfg")

[gui]

theme/custom="res://ui/game_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.95, 0.92, 0.85, 1)
